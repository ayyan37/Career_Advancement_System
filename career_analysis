    "def calculate_score(answers):\n",
    "    scores = career_categories.copy()\n",
    "\n",
    "    for answer in answers:\n",
    "        if answer in scores:\n",
    "            scores[answer] += 1\n",
    "\n",
    "    return scores\n",
    "\n",
    "\n",
    "# Test\n",
    "test_answers = [\n",
    "    \"Programming\",\n",
    "    \"Data Analytics\",\n",
    "    \"Programming\"\n",
    "]\n",
    "\n",
    "scores = calculate_score(test_answers)\n",
    "\n",
    "print(scores)"
   ]
