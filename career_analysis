    "def recommend_career(scores):\n",
    "    recommended_career = max(scores, key=scores.get)\n",
    "    highest_score = scores[recommended_career]\n",
    "\n",
    "    return recommended_career, highest_score\n",
    "\n",
    "\n",
    "career, score = recommend_career(scores)\n",
    "\n",
    "print(\"Recommended Career:\", career)\n",
    "print(\"Score:\", score)"
